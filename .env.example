# Generate unique secrets with python3 scripts/init-env.py. Never commit .env.
COMPOSE_PROJECT_NAME=punting
POSTGRES_DB=punting
POSTGRES_USER=punting
POSTGRES_PASSWORD=
API_TOKEN=
ADMIN_USERNAME=analyst
ADMIN_PASSWORD=

# Public HTTPS deployment: set a real DNS name (no scheme) and ACME email.
DOMAIN=
ACME_EMAIL=

# Enable the ingest profile only after validating your Professional V2 contract.
PUNTING_FORM_API_KEY=
PROVIDER_BASE_URL=https://api.puntingform.com.au
PROVIDER_CONFIG_PATH=/app/config/provider.json
LOG_LEVEL=INFO
# At 05:15 Australia/Perth, ingest today and this many preceding days.
INGEST_LOOKBACK_DAYS=7
